# 环境变量：通常由 install.sh 自动生成 .env，不需要手动复制本文件。
# docker compose 会读取 .env 做变量替换，值发生变化后执行 `make restart` 生效。

# Grafana 管理员密码（install.sh 会生成 32 位随机值并 chmod 600）
GRAFANA_PASSWORD=

# ---------- 以下仅在公开访问模式（install.sh --public）下由脚本填写 ----------

# 对外站点地址：域名则自动申请 TLS 证书；`:8080` 这类纯端口表示走 HTTP
PUBLIC_ADDR=

# Caddy Basic Auth：用户名 + bcrypt 哈希，明文密码另存在 CADDY_AUTH_PASSWORD
BASIC_AUTH_USER=admin
CADDY_BASIC_AUTH=
CADDY_AUTH_PASSWORD=

# 公开模式下 Caddy 已经挡住一层认证，Grafana 降为只读匿名访问，避免登录两次
GF_AUTH_ANONYMOUS_ENABLED=false

# 写入 public 后，所有 docker compose 命令都会自动带上 caddy 服务
COMPOSE_PROFILES=
